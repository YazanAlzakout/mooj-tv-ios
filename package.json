{
  "name": "mooj-tv-ios",
  "main": "expo-router/entry",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "doctor": "npx expo-doctor",
    "ios": "expo run:ios",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "test:playback": "node --experimental-strip-types --test tests/*.test.mjs",
    "verify:ios": "node tools/verify-ios.js"
  },
  "dependencies": {
    "@lunarr/vlc-player": "^2.1.1",
    "expo": "~57.0.34",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.24",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.22",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-in-app-updates": "^0.12.0",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.14",
    "expo-localization": "~57.0.2",
    "expo-navigation-bar": "~57.0.3",
    "expo-network": "~57.0.3",
    "expo-router": "~57.0.32",
    "expo-screen-orientation": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.12",
    "expo-sqlite": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86-stable",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "^0.1.6",
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    },
    "autolinking": {
      "buildFromSource": [
        "expo-video"
      ]
    }
  }
}
