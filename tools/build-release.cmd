@echo off
rem ---------------------------------------------------------------------------
rem  Build the release APK on a Windows account whose name contains a space.
rem
rem  Why this wrapper exists, 2026-11-18.
rem
rem  Every Gradle build on this machine failed for three days with:
rem
rem      java.io.IOException: Unable to establish loopback connection
rem
rem  It is not a Gradle fault and not a project fault. Gradle opens an NIO
rem  Selector for every client/daemon message, and on Windows the JDK builds that
rem  Selector's internal wake-up pipe out of an AF_UNIX socket pair. The JDK puts
rem  that socket file in the directory named by the TEMP environment variable.
rem
rem  This account is "TOTAL TECH" — the space makes Windows hand out the 8.3
rem  short name, so TEMP reads C:\Users\TOTALT~1\AppData\Local\Temp. Binding an
rem  AF_UNIX socket there succeeds and connecting to it fails with WSAEINVAL
rem  ("Invalid argument: connect"), so Selector.open() throws and every build
rem  dies before a single task runs.
rem
rem  Measured, not guessed: plain TCP loopback worked 10 times out of 10 in the
rem  same JVM, while Pipe.open() failed 10 out of 10; an AF_UNIX round trip under
rem  C:\Users\TOTALT~1\... failed and the identical round trip under a short path
rem  succeeded. Reboots, `netsh winsock reset` and disabling the antivirus all
rem  changed nothing, because none of them was the cause.
rem
rem  The fix is one JDK system property pointing AF_UNIX at a short path.
rem  JAVA_TOOL_OPTIONS is used rather than org.gradle.jvmargs because BOTH JVMs
rem  need it — the daemon and the client that talks to it — and because
rem  android/gradle.properties is regenerated by `expo prebuild --clean`.
rem
rem  Usage, from anywhere:
rem      tools\build-release.cmd                  (assembleRelease, the APK)
rem      tools\build-release.cmd bundleRelease    (the AAB for Play)
rem ---------------------------------------------------------------------------

setlocal

set "PROJECT=%~dp0.."
set "GRADLE_TMP=%PROJECT%\.gradle-tmp"

if not exist "%GRADLE_TMP%" mkdir "%GRADLE_TMP%"

set "JAVA_TOOL_OPTIONS=-Djdk.net.unixdomain.tmpdir=%GRADLE_TMP%"

rem `if not defined` rather than `if "%TASK%"==""`: the string comparison breaks
rem the moment more than one task is passed, because CMD expands it to
rem   if "assembleRelease bundleRelease"==""
rem and chokes on the embedded quotes with "was unexpected at this time". Caught
rem on 2026-11-18 by the build it was supposed to run silently not running at all.
set "TASK=%*"
if not defined TASK set "TASK=assembleRelease"

echo Building %TASK% with AF_UNIX sockets under %GRADLE_TMP%
call "%PROJECT%\android\gradlew.bat" -p "%PROJECT%\android" %TASK%

endlocal
